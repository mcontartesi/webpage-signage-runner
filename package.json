{
  "name": "webpage-signage-runner",
  "version": "1.1.0",
  "description": "Production-grade, unattended Multi-Display Digital Signage Kiosk runner for Windows and Linux",
  "author": "Maximiliano Contartesi",
  "license": "MIT",
  "main": "dist/main/index.js",
  "homepage": "https://github.com/mcontartesi/webpage-signage-runner",
  "repository": {
    "type": "git",
    "url": "https://github.com/mcontartesi/webpage-signage-runner.git"
  },
  "keywords": [
    "digital-signage",
    "kiosk",
    "multi-display",
    "electron",
    "typescript",
    "unattended",
    "screensaver-inhibitor",
    "watchdog"
  ],
  "scripts": {
    "clean": "node scripts/clean.js",
    "build": "node scripts/build.js",
    "build:watch": "node scripts/build.js --watch",
    "typecheck": "tsc --noEmit",
    "start": "electron .",
    "dev": "node scripts/dev.js",
    "test": "vitest run",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "release": "npm run build && electron-builder --publish always",
    "release:win": "npm run build && electron-builder --win --publish always",
    "release:linux": "npm run build && electron-builder --linux --publish always",
    "wiki:publish": "node scripts/publish-wiki.js"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
